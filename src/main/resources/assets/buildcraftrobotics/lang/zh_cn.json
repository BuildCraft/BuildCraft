  "item.buildcraftrobotics.zone_planner": "Zone Planner",
  "block.buildcraftrobotics.zone_planner": "Zone Planner",
  "buildcraftrobotics.help.zone_planner.map.title": "Zone map",
  "buildcraftrobotics.help.zone_planner.map.desc": "This panel shows the area around the Zone Planner. Left-click and drag to mark a rectangle on the selected layer. Right-click the map to recenter it on that point. Use the mouse wheel, +, or - to change zoom.",
  "buildcraftrobotics.help.zone_planner.layers.title": "Zone layers",
  "buildcraftrobotics.help.zone_planner.layers.desc": "Each brush colour is a separate zone layer. Click a brush to choose which layer you are editing. Robots and gates can later use the exported Map Location for the selected layer.",
  "buildcraftrobotics.help.zone_planner.mode.title": "Add / remove mode",
  "buildcraftrobotics.help.zone_planner.mode.desc": "The + / - button changes what dragging on the map does. In + mode selected blocks are added to the current layer. In - mode selected blocks are removed from it.",
  "buildcraftrobotics.help.zone_planner.fullscreen.title": "Fullscreen map",
  "buildcraftrobotics.help.zone_planner.fullscreen.desc": "FS opens the map fullscreen. Shift+M also opens fullscreen. Press M or Esc to return to the normal Zone Planner window.",
  "buildcraftrobotics.help.zone_planner.name.title": "Map name",
  "buildcraftrobotics.help.zone_planner.name.desc": "The text in this field becomes the name of the exported Map Location. Click the field to edit it. Press Enter or Esc, or click outside the field, to stop typing.",
  "buildcraftrobotics.help.zone_planner.crafting.title": "Map Location export",
  "buildcraftrobotics.help.zone_planner.crafting.desc": "Put a blank Map Location in the top slot. After the progress bar fills, the lower slot receives a Map Location containing the currently selected zone layer and the name from the text field.",
  "buildcraftrobotics.help.zone_planner.import.title": "Import Map Location",
  "buildcraftrobotics.help.zone_planner.import.desc": "Put an existing zone Map Location here to load its area into the selected colour layer. This is useful for editing a zone that was saved earlier.",
  "item.buildcraftrobotics.requester": "Requester",
  "block.buildcraftrobotics.requester": "Requester",
  "buildcraftrobotics.help.requester.templates.title": "Request templates",
  "buildcraftrobotics.help.requester.templates.desc": "Click a slot with an item stack on the cursor to set the requested item and amount. Click with an empty cursor, or shift-click the template slot, to clear it.",
  "buildcraftrobotics.help.requester.storage.title": "Delivered items",
  "buildcraftrobotics.help.requester.storage.desc": "Delivery robots fill these slots until the matching request template is satisfied. Only items matching the template can be inserted into each slot.",
  "buildcraftrobotics.help.requester.arrow.title": "Requester flow",
  "buildcraftrobotics.help.requester.arrow.desc": "The left side defines what is wanted. The right side stores what robots have delivered."
